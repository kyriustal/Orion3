# Google Gemini API Key (Multimodal: Áudio/Voz, Imagens, Vídeos e Documentos)
# Obtenha gratuitamente em https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Configuration
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Meta / WhatsApp Token
META_VERIFY_TOKEN=your_token_here
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here
META_WHATSAPP_CONFIG_ID=your_facebook_login_for_business_config_id_here
PUBLIC_BASE_URL=https://your-domain.com
VITE_META_APP_ID=your_meta_app_id_here
VITE_META_WHATSAPP_CONFIG_ID=your_facebook_login_for_business_config_id_here
# Opcional: use apenas se o seu Embedded Signup Builder exigir um fluxo específico, como whatsapp_business_app_onboarding.
VITE_META_WHATSAPP_FEATURE_TYPE=

# SMTP / Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM="Orion Platform <no-reply@orion.com>"

# Deepseek API Configuration
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Google Calendar Integration (OAuth 2.0)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_DIRECT_URL=https://accounts.google.com/o/oauth2/v2/auth?...
GOOGLE_USER_REFRESH_TOKEN=your_google_refresh_token_here

# Microsoft Outlook Calendar Integration (OAuth 2.0)
MICROSOFT_CLIENT_ID=your_microsoft_client_id_here
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret_here
# Google Sheets / Apps Script Webhook Integration
# URL gerada na Implantação do Apps Script (terminada em /exec)
GOOGLE_SCRIPT_WEBAPP_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
